# Copy to .env on the syslog server VM and edit. No secrets in this file.

# Name of this collector, attached to every event.
COLLECTOR_ID=moni-syslog-01

# Monicomm ingest endpoint (host:port). Until the Monicomm stack exists, point it at collector/dev-ingest.
MONICOMM_INGEST_ADDRESS=10.20.0.10:6000

# Data disk paths on the VM (docs/runbooks/collector-servers-setup.md).
ARCHIVE_DIR=/srv/monicomm/syslog-archive
BUFFER_DIR=/srv/monicomm/vector-buffer

# Disk buffer for events waiting for Monicomm, in bytes. Size for >= 24 h at peak rate. Minimum 268435488.
FORWARD_BUFFER_BYTES=21474836480

# Kernel receive buffer for the UDP 514 socket, in bytes (also raise net.core.rmem_max on the host).
UDP_RECEIVE_BUFFER_BYTES=16777216
