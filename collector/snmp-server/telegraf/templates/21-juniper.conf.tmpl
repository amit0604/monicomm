# moni-match: vendor=juniper role=*
# Juniper-specific MIBs. Numeric OIDs so polling needs no MIB files.

# --- every 60 s: per-component state, temperature, CPU, memory (JUNIPER-MIB jnxOperatingTable) ---
[[inputs.snmp]]
  name = "snmp_juniper_operating"
  interval = "60s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true

  [[inputs.snmp.table]]
    name = "snmp_juniper_operating"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "jnxOperatingDescr"
      oid = ".1.3.6.1.4.1.2636.3.1.13.1.5"
      is_tag = true
    [[inputs.snmp.table.field]]
      name = "jnxOperatingState"
      oid = ".1.3.6.1.4.1.2636.3.1.13.1.6"
    [[inputs.snmp.table.field]]
      name = "jnxOperatingTemp"
      oid = ".1.3.6.1.4.1.2636.3.1.13.1.7"
    [[inputs.snmp.table.field]]
      name = "jnxOperatingCPU"
      oid = ".1.3.6.1.4.1.2636.3.1.13.1.8"
    [[inputs.snmp.table.field]]
      name = "jnxOperatingBuffer"
      oid = ".1.3.6.1.4.1.2636.3.1.13.1.11"
