# moni-match: vendor=cisco role=*
# Cisco-specific MIBs. Numeric OIDs so polling needs no MIB files.

# --- every 60 s: CPU and memory (CISCO-PROCESS-MIB cpmCPUTotalTable) ---
[[inputs.snmp]]
  name = "snmp_cisco_cpu"
  interval = "60s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true

  [[inputs.snmp.table]]
    name = "snmp_cisco_cpu"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "cpmCPUTotal5secRev"
      oid = ".1.3.6.1.4.1.9.9.109.1.1.1.1.6"
    [[inputs.snmp.table.field]]
      name = "cpmCPUTotal1minRev"
      oid = ".1.3.6.1.4.1.9.9.109.1.1.1.1.7"
    [[inputs.snmp.table.field]]
      name = "cpmCPUTotal5minRev"
      oid = ".1.3.6.1.4.1.9.9.109.1.1.1.1.8"
    [[inputs.snmp.table.field]]
      name = "cpmCPUMemoryUsed"
      oid = ".1.3.6.1.4.1.9.9.109.1.1.1.1.12"
    [[inputs.snmp.table.field]]
      name = "cpmCPUMemoryFree"
      oid = ".1.3.6.1.4.1.9.9.109.1.1.1.1.13"

# --- every 5 min: environment (CISCO-ENVMON-MIB) and CDP neighbors (CISCO-CDP-MIB) ---
[[inputs.snmp]]
  name = "snmp_cisco_env"
  interval = "300s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true

  [[inputs.snmp.table]]
    name = "snmp_cisco_temperature"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "descr"
      oid = ".1.3.6.1.4.1.9.9.13.1.3.1.2"
      is_tag = true
    [[inputs.snmp.table.field]]
      name = "celsius"
      oid = ".1.3.6.1.4.1.9.9.13.1.3.1.3"
    [[inputs.snmp.table.field]]
      name = "state"
      oid = ".1.3.6.1.4.1.9.9.13.1.3.1.6"

  [[inputs.snmp.table]]
    name = "snmp_cisco_fan"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "descr"
      oid = ".1.3.6.1.4.1.9.9.13.1.4.1.2"
      is_tag = true
    [[inputs.snmp.table.field]]
      name = "state"
      oid = ".1.3.6.1.4.1.9.9.13.1.4.1.3"

  [[inputs.snmp.table]]
    name = "snmp_cisco_psu"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "descr"
      oid = ".1.3.6.1.4.1.9.9.13.1.5.1.2"
      is_tag = true
    [[inputs.snmp.table.field]]
      name = "state"
      oid = ".1.3.6.1.4.1.9.9.13.1.5.1.3"

  # cdpCacheTable. Index = ifIndex.deviceIndex.
  [[inputs.snmp.table]]
    name = "snmp_cdp_neighbor"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "cdpCacheAddress"
      oid = ".1.3.6.1.4.1.9.9.23.1.2.1.1.4"
      conversion = "ipaddr"
    [[inputs.snmp.table.field]]
      name = "cdpCacheDeviceId"
      oid = ".1.3.6.1.4.1.9.9.23.1.2.1.1.6"
    [[inputs.snmp.table.field]]
      name = "cdpCacheDevicePort"
      oid = ".1.3.6.1.4.1.9.9.23.1.2.1.1.7"
    [[inputs.snmp.table.field]]
      name = "cdpCachePlatform"
      oid = ".1.3.6.1.4.1.9.9.23.1.2.1.1.8"
