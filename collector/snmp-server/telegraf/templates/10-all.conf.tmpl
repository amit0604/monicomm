# moni-match: vendor=* role=*
# Standard MIBs, every device. Numeric OIDs so polling needs no MIB files.

# --- every 60 s: uptime + interfaces (IF-MIB) ---
[[inputs.snmp]]
  name = "snmp_system"
  interval = "60s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true
  [[inputs.snmp.field]]
    name = "sysUpTime"
    oid = ".1.3.6.1.2.1.1.3.0"

  [[inputs.snmp.table]]
    name = "snmp_interface"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "ifName"
      oid = ".1.3.6.1.2.1.31.1.1.1.1"
      is_tag = true
    [[inputs.snmp.table.field]]
      name = "ifAlias"
      oid = ".1.3.6.1.2.1.31.1.1.1.18"
    [[inputs.snmp.table.field]]
      name = "ifType"
      oid = ".1.3.6.1.2.1.2.2.1.3"
    [[inputs.snmp.table.field]]
      name = "ifAdminStatus"
      oid = ".1.3.6.1.2.1.2.2.1.7"
    [[inputs.snmp.table.field]]
      name = "ifOperStatus"
      oid = ".1.3.6.1.2.1.2.2.1.8"
    [[inputs.snmp.table.field]]
      name = "ifLastChange"
      oid = ".1.3.6.1.2.1.2.2.1.9"
    [[inputs.snmp.table.field]]
      name = "ifHighSpeed"
      oid = ".1.3.6.1.2.1.31.1.1.1.15"
    [[inputs.snmp.table.field]]
      name = "ifHCInOctets"
      oid = ".1.3.6.1.2.1.31.1.1.1.6"
    [[inputs.snmp.table.field]]
      name = "ifHCOutOctets"
      oid = ".1.3.6.1.2.1.31.1.1.1.10"
    [[inputs.snmp.table.field]]
      name = "ifHCInUcastPkts"
      oid = ".1.3.6.1.2.1.31.1.1.1.7"
    [[inputs.snmp.table.field]]
      name = "ifHCOutUcastPkts"
      oid = ".1.3.6.1.2.1.31.1.1.1.11"
    [[inputs.snmp.table.field]]
      name = "ifInDiscards"
      oid = ".1.3.6.1.2.1.2.2.1.13"
    [[inputs.snmp.table.field]]
      name = "ifInErrors"
      oid = ".1.3.6.1.2.1.2.2.1.14"
    [[inputs.snmp.table.field]]
      name = "ifOutDiscards"
      oid = ".1.3.6.1.2.1.2.2.1.19"
    [[inputs.snmp.table.field]]
      name = "ifOutErrors"
      oid = ".1.3.6.1.2.1.2.2.1.20"

# --- every 5 min: identity, LLDP neighbors, ARP (Mapper) ---
[[inputs.snmp]]
  name = "snmp_identity"
  interval = "300s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true
  [[inputs.snmp.field]]
    name = "sysDescr"
    oid = ".1.3.6.1.2.1.1.1.0"
  [[inputs.snmp.field]]
    name = "sysObjectID"
    oid = ".1.3.6.1.2.1.1.2.0"
  [[inputs.snmp.field]]
    name = "sysLocation"
    oid = ".1.3.6.1.2.1.1.6.0"

  # LLDP-MIB lldpRemTable. Index = timeMark.localPortNum.remIndex.
  [[inputs.snmp.table]]
    name = "snmp_lldp_neighbor"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "lldpRemChassisId"
      oid = ".1.0.8802.1.1.2.1.4.1.1.5"
      conversion = "hwaddr"
    [[inputs.snmp.table.field]]
      name = "lldpRemPortId"
      oid = ".1.0.8802.1.1.2.1.4.1.1.7"
    [[inputs.snmp.table.field]]
      name = "lldpRemPortDesc"
      oid = ".1.0.8802.1.1.2.1.4.1.1.8"
    [[inputs.snmp.table.field]]
      name = "lldpRemSysName"
      oid = ".1.0.8802.1.1.2.1.4.1.1.9"

  # IP-MIB ipNetToMediaTable (IPv4 ARP). Index = ifIndex.ipAddress.
  [[inputs.snmp.table]]
    name = "snmp_arp"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "ipNetToMediaPhysAddress"
      oid = ".1.3.6.1.2.1.4.22.1.2"
      conversion = "hwaddr"
    [[inputs.snmp.table.field]]
      name = "ipNetToMediaNetAddress"
      oid = ".1.3.6.1.2.1.4.22.1.3"
      conversion = "ipaddr"
    [[inputs.snmp.table.field]]
      name = "ipNetToMediaType"
      oid = ".1.3.6.1.2.1.4.22.1.4"

# --- every hour: hardware inventory (ENTITY-MIB entPhysicalTable) ---
[[inputs.snmp]]
  name = "snmp_inventory"
  interval = "3600s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true

  [[inputs.snmp.table]]
    name = "snmp_entity"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "entPhysicalDescr"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.2"
    [[inputs.snmp.table.field]]
      name = "entPhysicalClass"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.5"
    [[inputs.snmp.table.field]]
      name = "entPhysicalName"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.7"
    [[inputs.snmp.table.field]]
      name = "entPhysicalSoftwareRev"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.10"
    [[inputs.snmp.table.field]]
      name = "entPhysicalSerialNum"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.11"
    [[inputs.snmp.table.field]]
      name = "entPhysicalModelName"
      oid = ".1.3.6.1.2.1.47.1.1.1.1.13"
