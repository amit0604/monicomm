# moni-match: vendor=* role=router|firewall
# Routing peers, standard MIBs (both vendors). Never walk the routing table itself (plan §4.4).
# BGP4-MIB covers IPv4 peers in the default instance; IPv6/VRF peers need the vendor MIBs (later).

[[inputs.snmp]]
  name = "snmp_routing"
  interval = "60s"
  agents = @AGENTS@
  @SNMP_V3@

  [[inputs.snmp.field]]
    name = "sysName"
    oid = ".1.3.6.1.2.1.1.5.0"
    is_tag = true

  # BGP4-MIB bgpPeerTable. Index = peer IPv4 address.
  [[inputs.snmp.table]]
    name = "snmp_bgp_peer"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "bgpPeerState"
      oid = ".1.3.6.1.2.1.15.3.1.2"
    [[inputs.snmp.table.field]]
      name = "bgpPeerAdminStatus"
      oid = ".1.3.6.1.2.1.15.3.1.3"
    [[inputs.snmp.table.field]]
      name = "bgpPeerRemoteAddr"
      oid = ".1.3.6.1.2.1.15.3.1.7"
      conversion = "ipaddr"
    [[inputs.snmp.table.field]]
      name = "bgpPeerRemoteAs"
      oid = ".1.3.6.1.2.1.15.3.1.9"
    [[inputs.snmp.table.field]]
      name = "bgpPeerFsmEstablishedTransitions"
      oid = ".1.3.6.1.2.1.15.3.1.15"
    [[inputs.snmp.table.field]]
      name = "bgpPeerFsmEstablishedTime"
      oid = ".1.3.6.1.2.1.15.3.1.16"

  # OSPF-MIB ospfNbrTable. Index = neighbor IP.addressLessIndex.
  [[inputs.snmp.table]]
    name = "snmp_ospf_neighbor"
    inherit_tags = ["sysName"]
    index_as_tag = true
    [[inputs.snmp.table.field]]
      name = "ospfNbrIpAddr"
      oid = ".1.3.6.1.2.1.14.10.1.1"
      conversion = "ipaddr"
    [[inputs.snmp.table.field]]
      name = "ospfNbrRtrId"
      oid = ".1.3.6.1.2.1.14.10.1.3"
      conversion = "ipaddr"
    [[inputs.snmp.table.field]]
      name = "ospfNbrState"
      oid = ".1.3.6.1.2.1.14.10.1.6"
