# SNMPv3 read-only polling user (matches "moni-poll" in the device templates, plan §5).
# Copy to snmp_ro.env, fill in, then: chmod 600 snmp_ro.env. Never commit the real file.
# Passwords: 8+ characters, no double quotes, no $ or backslash (they pass through shell and TOML).
SNMP_USER=moni-poll
SNMP_AUTH_PROTOCOL=SHA
SNMP_AUTH_PASS=change-me-auth
SNMP_PRIV_PROTOCOL=AES
SNMP_PRIV_PASS=change-me-priv
