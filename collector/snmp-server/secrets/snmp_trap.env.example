# SNMPv3 trap/inform user (matches "moni-trap" in the device templates, plan §5).
# Copy to snmp_trap.env, fill in, then: chmod 600 snmp_trap.env. Never commit the real file.
# Passwords: 8+ characters, no double quotes, no $ or backslash.

# Fixed engine ID of this trap receiver, in hex. Devices sending informs are configured with it
# (Cisco "snmp-server engineID remote", Junos "usm remote-engine"). Pick once, never change.
# Format: 0x80001f8804 (net-snmp enterprise, text format) + hex of a short name. Example = "moni-trapd".
TRAPD_ENGINE_ID=0x80001f88046d6f6e692d7472617064

TRAP_USER=moni-trap
TRAP_AUTH_PROTOCOL=SHA
TRAP_AUTH_PASS=change-me-auth
TRAP_PRIV_PROTOCOL=AES
TRAP_PRIV_PASS=change-me-priv

# Only for devices that send plain v3 TRAPS (not informs): their engine IDs, space-separated.
TRAP_DEVICE_ENGINE_IDS=

# Only for legacy v2c devices (listed exceptions). Leave empty to refuse v2c.
TRAP_V2C_COMMUNITY=
