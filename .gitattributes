# Files that run or are read inside Linux containers/VMs must keep LF line endings,
# even when checked out on Windows.
*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.tmpl      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.csv       text eol=lf
*.example   text eol=lf
Dockerfile  text eol=lf
