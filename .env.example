# Copy to .env and change for your site. Never commit .env.
# prod on every site. Set dev only on a developer machine (it unlocks dev-only options below).
MONICOMM_ENV=prod
MONICOMM_HTTP_PORT=8080

POSTGRES_USER=monicomm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monicomm
MONICOMM_DATABASE_URL=postgresql://monicomm:change-me@db:5432/monicomm
MONICOMM_REDIS_URL=redis://queue:6379/0

# Must point inside the closed network. The api refuses public URLs.
MONICOMM_LLM_BASE_URL=http://llm:11434
MONICOMM_LLM_MODEL=qwen2.5:7b

# ollama = local model (the only option on the closed network).
# gemini = DEV-ONLY exception: Google AI Studio, works only with MONICOMM_ENV=dev and only when the api
# runs on a developer machine (the Docker api has no internet). Put the key in your local .env, never in git.
MONICOMM_LLM_PROVIDER=ollama
MONICOMM_GEMINI_API_KEY=
MONICOMM_GEMINI_MODEL=gemini-2.5-flash

# Dashboard demo data (fabricated, labelled DEMO in the UI). Works only with MONICOMM_ENV=dev.
MONICOMM_DEMO_DATA=false

# Chatchup (PCAP). Uploaded captures can hold sensitive data: keep this on access-controlled storage.
MONICOMM_PCAP_DATA_DIR=/data/pcap
MONICOMM_PCAP_MAX_UPLOAD_MB=500

# Incident Investigator (live incident analyzer)
# Collector dev-ingest directory (<dir>/<YYYY-MM-DD>/{syslog,trap,snmp_metric}.jsonl), path inside
# the api container. Empty = listener off. Mount it read-only in docker-compose.yml first.
MONICOMM_INVESTIGATOR_INGEST_DIR=
# Where incidents (incidents/<id>.json) and read offsets (offsets.json) are kept.
MONICOMM_INVESTIGATOR_DATA_DIR=/data/investigator
# Correlation window in seconds: events this close together are grouped into one incident.
MONICOMM_INVESTIGATOR_WINDOW_S=120
# How often the listener reads new lines, in seconds.
MONICOMM_INVESTIGATOR_POLL_S=5
